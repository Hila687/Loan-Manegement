# Public address of the site (also sets allowed host + trusted origin)
SITE_URL=https://gemach.example.org

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=false

# Database (same values as in .env; "db" is the compose service name)
DATABASE_URL=postgresql://gemach:change-me-long-random@db:5432/gemach

# Optional: move Django's admin away from /admin/
# DJANGO_ADMIN_URL=manage-7f3k/

# HTTPS (Caddy in front handles certificates)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# ---- Optional. Leave empty to run free: sign-in with ID number + password ----
# ---- SMS (Twilio) - sign-in codes, account messages, reminders ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=   (reminders by WhatsApp only)

# ---- Email - sign-in codes by email ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="גמ\"ח חסדי יעקב <no-reply@gemach.example.org>"

# ---- Jobs ----
REMINDERS_HOUR=9
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30

# ---- Server ----
WEB_CONCURRENCY=3
LOG_LEVEL=INFO